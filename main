<script>
// ═══════════════════════════════════════════════════════════
//  CONSTANTS
// ═══════════════════════════════════════════════════════════
const HOURS   = Array.from({length:24},(_,i)=>`${String(i+1).padStart(2,'0')}:00`);
const PERIODS = Array.from({length:48},(_,i)=>{
  const h=Math.floor(i/2), m=i%2*30;
  return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`;
});
const SECTIONS = [
  {id:'s0',icon:'📅',title:'Thông tin & A0',    desc:'Ngày, người BC, kế hoạch, đăng ký A0'},
  {id:'s1',icon:'📊',title:'Chỉ số công tơ',    desc:'Xuất tuyến, đầu cực, tự dùng — TM1 & TM2'},
  {id:'s2',icon:'💧',title:'Thủy văn & Hồ chứa',desc:'Mực nước, lưu lượng, lũy kế, chênh lệch'},
  {id:'s3',icon:'📈',title:'Biểu đồ công suất', desc:'48 chu kỳ × 30 phút — TM1 / TM2'},
  {id:'s4',icon:'📝',title:'Sự kiện & Ký tên',  desc:'Nhật ký vận hành, xác nhận'},
];
let currentSection = 0;

// ═══════════════════════════════════════════════════════════
//  MASTER DATA
// ═══════════════════════════════════════════════════════════
const D = {
  // ─ Thông tin chung ─
  date:'2026-05-18', reporter:'Nguyễn Văn Tuấn',
  kh_ngay:0.5000,          // Kế hoạch sản lượng ngày VRG giao (triệu kWh)

  // ─ A0 đăng ký & huy động (MWh) ─
  sl_a0_tm1:250, sl_a0_tm2:265,
  sl_hd_tm1:252, sl_hd_tm2:264,
  cs_kd_tm1:12.25, cs_kd_tm2:12.25,   // Công suất khả dụng (MW)

  // ─ Công tơ TM1 (MWh) ─
  xt_tm1_0:15000.000, xt_tm1_24:15252.000,   // Xuất tuyến
  dc_tm1_0:15800.000, dc_tm1_24:16058.400,   // Đầu cực
  td_tm1_0:800.000,   td_tm1_24:806.400,     // Tự dùng

  // ─ Công tơ TM2 (MWh) ─
  xt_tm2_0:14800.000, xt_tm2_24:15064.000,
  dc_tm2_0:15600.000, dc_tm2_24:15871.300,
  td_tm2_0:800.000,   td_tm2_24:807.300,

  // ─ Mực nước (m) ─
  mn_tl_0:769.52, mn_tl_24:768.95,     // Thượng lưu 0h và 24h
  mn_hl:616.80,                          // Hạ lưu (m)

  // ─ Lưu lượng (m³/s) ─
  q_ve:18.2,            // Q về hồ bình quân ngày
  q_phat_tm1:9.8,       // Q phát điện TM1
  q_phat_tm2:10.1,      // Q phát điện TM2
  q_tran:0,             // Q xả tràn
  q_day:0,              // Q xả đáy

  // ─ Lũy kế nước về (triệu m³) ─
  nuoc_lk_thang:42.50,
  nuoc_lk_nam:185.30,

  // ─ Lũy kế SL TM (MWh) ─
  sl_tm_lk_thang:7850,
  sl_tm_lk_nam:48320,
  sl_tm_lk_total:1892820,

  // ─ Chênh lệch SL vs KH (triệu kWh) – nhập tay ─
  chenh_su_co:0,
  chenh_su_co_lk_t:0,  chenh_su_co_lk_n:0,
  chenh_tv_lk_t:0,     chenh_tv_lk_n:0,     // do thủy văn
  chenh_evn_lk_t:0,    chenh_evn_lk_n:0,

  // ─ Giờ ngừng máy ─
  gio_ngung_nm:0,  gio_ngung_tm1:0,  gio_ngung_tm2:0,
  gio_ngung_nm_lk_t:0, gio_ngung_tm1_lk_t:0, gio_ngung_tm2_lk_t:0,
  gio_ngung_nm_lk_n:0, gio_ngung_tm1_lk_n:0, gio_ngung_tm2_lk_n:0,

  // ─ Sự kiện & ký tên ─
  ev_tm1:'* Từ 00h00 đến 24h00 vận hành ổn định theo huy động của điều độ A0.',
  ev_tm2:'* Từ 00h00 đến 24h00 vận hành ổn định theo huy động của điều độ A0.',
  ev_dap:'* Đập vận hành bình thường. Không phát sinh xả tràn, xả đáy trong ngày. Cửa van tràn đóng bình thường.',
  ev_tba:'* Trạm biến áp 110/22 kV vận hành bình thường, không sự cố. Các thiết bị bảo vệ hoạt động tốt.',
  ev_note:'* Mực nước hồ chứa duy trì trong phạm vi vận hành bình thường. Tình hình thủy văn ổn định, lưu lượng nước về đạt 18.2 m³/s.',
  signer:'Nguyễn Văn Tuấn', sign_date:'19/05/2026',
};

// Power periods: 48 × 30min – TM1_P (MW), TM2_P (MW)
const P = PERIODS.map((_,i)=>{
  if(i<12)  return {tm1_p:10.5,tm2_p:11.0};   // 00:00–06:00 ngoài giờ cao điểm
  if(i<38)  return {tm1_p:11.5,tm2_p:12.0};   // 06:00–19:00 giờ cao điểm
  return            {tm1_p:10.5,tm2_p:11.0};   // 19:00–24:00
});

// ═══════════════════════════════════════════════════════════
//  HELPERS
// ═══════════════════════════════════════════════════════════
const n    = k => parseFloat(D[k]) || 0;
const fmt  = (v,d=2) => v==null||isNaN(v)?'—':Number(v).toFixed(d);
const fmtN = v => v==null||isNaN(v)?'—':Number(v).toLocaleString('vi-VN',{maximumFractionDigits:3});
const $ = id => document.getElementById(id);

// ═══════════════════════════════════════════════════════════
//  CALCULATIONS
// ═══════════════════════════════════════════════════════════
function calc(){
  // Công tơ TM1
  const xt_tm1 = n('xt_tm1_24')-n('xt_tm1_0');
  const dc_tm1 = n('dc_tm1_24')-n('dc_tm1_0');
  const td_tm1 = n('td_tm1_24')-n('td_tm1_0');
  // Công tơ TM2
  const xt_tm2 = n('xt_tm2_24')-n('xt_tm2_0');
  const dc_tm2 = n('dc_tm2_24')-n('dc_tm2_0');
  const td_tm2 = n('td_tm2_24')-n('td_tm2_0');
  // Tổng
  const xt_total = xt_tm1+xt_tm2;
  const dc_total = dc_tm1+dc_tm2;
  const td_total = td_tm1+td_tm2;
  const sl_tm    = xt_total/1000;   // triệu kWh
  // A0
  const sl_dk  = (n('sl_a0_tm1')+n('sl_a0_tm2'))/1000;
  const sl_hd  = (n('sl_hd_tm1')+n('sl_hd_tm2'))/1000;
  // Thủy văn
  const mn_diff = n('mn_tl_24')-n('mn_tl_0');
  const q_phat_total = n('q_phat_tm1')+n('q_phat_tm2');
  const q_xa = n('q_tran')+n('q_day');
  // Chênh lệch
  const chenh_tv  = n('kh_ngay')-sl_dk;   // do thủy văn / ấn định
  const chenh_evn = sl_dk-sl_tm;          // do EVN/A0 không huy động
  const chenh_total = n('chenh_su_co')+chenh_tv+chenh_evn;
  // Giờ công suất
  const hourlyP = HOURS.map((_,i)=>{
    const p=P[i*2]; const tm1=p?.tm1_p||0, tm2=p?.tm2_p||0;
    return {tm1,tm2,total:tm1+tm2};
  });
  return {xt_tm1,xt_tm2,xt_total,dc_tm1,dc_tm2,dc_total,
          td_tm1,td_tm2,td_total,sl_tm,sl_dk,sl_hd,
          mn_diff,q_phat_total,q_xa,chenh_tv,chenh_evn,chenh_total,hourlyP};
}

// ═══════════════════════════════════════════════════════════
//  FIELD BUILDER
// ═══════════════════════════════════════════════════════════
function fi(label,key,opts={}){
  const type=opts.type||'number', unit=opts.unit||'', dis=opts.disabled?'disabled':'';
  const val=D[key]??'';
  if(type==='textarea')
    return `<div class="field wide"><label>${label}</label><textarea data-key="${key}" rows="${opts.rows||3}" oninput="upd('${key}',this.value)" ${dis}>${val}</textarea></div>`;
  const unitHtml=unit?`<span class="unit">${unit}</span>`:'';
  const wrapCls=unit?'input-wrap':'';
  return `<div class="field"><label>${label}</label><div class="${wrapCls}"><input type="${type}" value="${val}" step="any" data-key="${key}" oninput="upd('${key}',this.value)" ${dis}>${unitHtml}</div></div>`;
}
function genHdr(){
  return `<div class="gen-header">
    <div class="gen-badge tm1">TM1 · Tổ máy 1 (12.25 MW)</div>
    <div class="gen-badge tm2">TM2 · Tổ máy 2 (12.25 MW)</div>
  </div>`;
}

// ═══════════════════════════════════════════════════════════
//  DATA UPDATE
// ═══════════════════════════════════════════════════════════
function upd(k,v){
  D[k]=v;
  updateSidebarKPI();
  if(k.startsWith('mn_')||k==='q_ve') updateWaterIndicator();
}
function updP(i,k,v){
  P[i][k]=parseFloat(v)||0;
  updatePowerChart();
}

// ═══════════════════════════════════════════════════════════
//  SIDEBAR KPI (live update)
// ═══════════════════════════════════════════════════════════
function updateSidebarKPI(){
  const c=calc();
  if($('skSLTM'))  $('skSLTM').textContent  = fmt(c.sl_tm,4);
  if($('skMNTL'))  $('skMNTL').textContent  = fmt(n('mn_tl_24'),2);
  if($('skQVe'))   $('skQVe').textContent   = fmt(n('q_ve'),1);
  if($('hdrDate')) $('hdrDate').textContent = D.date?`Ngày ${D.date}`:'';
  if($('skSLPct')){
    const pct=n('kh_ngay')>0?c.sl_tm/n('kh_ngay')*100:0;
    const cls=pct>=100?'good':'warn';
    $('skSLPct').innerHTML=`<span class="sk-badge ${cls}">${fmt(pct,1)}% KH ngày</span>`;
  }
  // Calc hints
  if($('calcXT'))
    $('calcXT').textContent=`Δ TM1 = ${fmt(c.xt_tm1,0)} MWh · TM2 = ${fmt(c.xt_tm2,0)} MWh · Tổng XT = ${fmt(c.xt_total,0)} MWh → SL TM = ${fmt(c.sl_tm,4)} tr.kWh`;
  if($('calcDC'))
    $('calcDC').textContent=`Δ TM1 = ${fmt(c.dc_tm1,0)} MWh · TM2 = ${fmt(c.dc_tm2,0)} MWh · Tổng ĐC = ${fmt(c.dc_total,0)} MWh`;
  if($('calcTD'))
    $('calcTD').textContent=`Δ TM1 = ${fmt(c.td_tm1,0)} MWh · TM2 = ${fmt(c.td_tm2,0)} MWh · Tổng TD = ${fmt(c.td_total,0)} MWh`;
  if($('calcSummary'))
    $('calcSummary').innerHTML=`<b>Đăng ký A0:</b> ${fmtN((n('sl_a0_tm1')+n('sl_a0_tm2')))} MWh &nbsp;·&nbsp; <b>Huy động:</b> ${fmtN((n('sl_hd_tm1')+n('sl_hd_tm2')))} MWh &nbsp;·&nbsp; <b>SL TM thực tế:</b> ${fmt(c.sl_tm,4)} tr.kWh`;
  if($('calcMN')){
    const diff=n('mn_tl_24')-n('mn_tl_0');
    const sign=diff>=0?'+':'';
    $('calcMN').textContent=`Biến động MN TL: ${sign}${fmt(diff,2)} m · Q phát tổng: ${fmt(c.q_phat_total,1)} m³/s · Q xả: ${fmt(c.q_xa,1)} m³/s`;
  }
  if($('calcChenh'))
    $('calcChenh').innerHTML=`<b>Tổng chênh:</b> ${fmt(c.chenh_total,4)} tr.kWh &nbsp;·&nbsp; Do thủy văn: ${fmt(c.chenh_tv,4)} &nbsp;·&nbsp; Do EVN/A0: ${fmt(c.chenh_evn,4)}`;
}

// ═══════════════════════════════════════════════════════════
//  WATER INDICATOR (live)
// ═══════════════════════════════════════════════════════════
function updateWaterIndicator(){
  if(!$('wiTL0')) return;
  const diff=n('mn_tl_24')-n('mn_tl_0');
  $('wiTL0').textContent  = fmt(n('mn_tl_0'),2);
  $('wiTL24').textContent = fmt(n('mn_tl_24'),2);
  $('wiHL').textContent   = fmt(n('mn_hl'),2);
  if($('wiDiff')){
    const sign=diff>=0?'+':'';
    const cls=diff>0.02?'rise':diff<-0.02?'drop':'stable';
    const arrow=diff>0.02?'↑':diff<-0.02?'↓':'→';
    $('wiDiff').textContent=`${arrow} ${sign}${fmt(diff,2)} m`;
    $('wiDiff').className=`wi-diff ${cls}`;
  }
}

// ═══════════════════════════════════════════════════════════
//  POWER CHART (input section 3)
// ═══════════════════════════════════════════════════════════
let powerChartInst=null;
function updatePowerChart(){
  const el=$('powerChartCanvas'); if(!el) return;
  const d1=P.map(p=>p.tm1_p||0);
  const d2=P.map(p=>p.tm2_p||0);
  const dT=d1.map((v,i)=>v+d2[i]);
  if(powerChartInst){
    powerChartInst.data.datasets[0].data=d1;
    powerChartInst.data.datasets[1].data=d2;
    powerChartInst.data.datasets[2].data=dT;
    powerChartInst.update('none'); return;
  }
  powerChartInst=new Chart(el,{
    type:'line',
    data:{labels:PERIODS,datasets:[
      {label:'TM1',data:d1,borderColor:'#1A5C38',backgroundColor:'rgba(26,92,56,.1)',tension:.35,pointRadius:0,fill:true},
      {label:'TM2',data:d2,borderColor:'#0E4C8A',backgroundColor:'rgba(14,76,138,.07)',tension:.35,pointRadius:0,fill:true},
      {label:'Tổng',data:dT,borderColor:'#546E7A',borderWidth:1.5,borderDash:[4,3],tension:.35,pointRadius:0,fill:false},
    ]},
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{position:'top',labels:{boxWidth:18,font:{size:11}}}},
      scales:{
        x:{ticks:{maxTicksLimit:12,font:{size:10}},grid:{display:false}},
        y:{beginAtZero:true,max:28,title:{display:true,text:'MW',font:{size:10}},ticks:{font:{size:10}}}
      }}
  });
}

