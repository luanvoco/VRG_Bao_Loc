/* ── S2: Thủy văn & Hồ chứa ── */
function renderS2(c){
  c.innerHTML=`
    <div class="card">
      <div class="card-title"><span class="card-icon">🌊</span>Mực nước hồ chứa</div>
      <div class="card-body">
