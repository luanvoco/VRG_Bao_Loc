          </div>
          <div class="wi-divider"></div>
          <div class="wi-item">
            <div class="wi-label">MN Thượng lưu — 24h</div>
            <div class="wi-value" id="wiTL24">${fmt(n('mn_tl_24'),2)}</div>
            <div class="wi-unit">m</div>
            <div class="wi-diff stable" id="wiDiff">→ 0.00 m</div>
          </div>
          <div class="wi-divider"></div>
          <div class="wi-item">
            <div class="wi-label">MN Hạ lưu</div>
            <div class="wi-value" id="wiHL">${fmt(n('mn_hl'),2)}</div>
            <div class="wi-unit">m</div>
          </div>
        </div>
        <div class="section-label">Nhập chỉ số mực nước (m)</div>
        <div class="form-row">
          ${fi('MN Thượng lưu — 0h00','mn_tl_0',{unit:'m'})}
          ${fi('MN Thượng lưu — 24h00','mn_tl_24',{unit:'m'})}
          ${fi('MN Hạ lưu','mn_hl',{unit:'m'})}
        </div>
        <div class="calc-hint water" id="calcMN">—</div>
      </div>
    </div>
    <div class="card">
      <div class="card-title"><span class="card-icon">💧</span>Lưu lượng nước (m³/s)</div>
      <div class="card-body">
        <div class="section-label">Lưu lượng bình quân ngày</div>
        <div class="form-row">
          ${fi('Q nước về hồ (bình quân)','q_ve',{unit:'m³/s'})}
          ${fi('Q phát điện TM1','q_phat_tm1',{unit:'m³/s'})}
          ${fi('Q phát điện TM2','q_phat_tm2',{unit:'m³/s'})}
        </div>
        <div class="section-label">Lưu lượng xả</div>
        <div class="form-row">
          ${fi('Q xả tràn','q_tran',{unit:'m³/s'})}
          ${fi('Q xả đáy','q_day',{unit:'m³/s'})}
        </div>
      </div>
    </div>
    <div class="card">
      <div class="card-title"><span class="card-icon">📋</span>Lũy kế & Chênh lệch KH</div>
      <div class="card-body">
        <div class="section-label">Lũy kế nước về hồ (triệu m³)</div>
        <div class="form-row">
          ${fi('LK tháng','nuoc_lk_thang',{unit:'tr.m³'})}
          ${fi('LK năm','nuoc_lk_nam',{unit:'tr.m³'})}
        </div>
        <div class="section-label">Lũy kế SL thương mại (MWh)</div>
        <div class="form-row">
          ${fi('LK tháng','sl_tm_lk_thang',{unit:'MWh'})}
          ${fi('LK năm','sl_tm_lk_nam',{unit:'MWh'})}
          ${fi('LK toàn bộ','sl_tm_lk_total',{unit:'MWh'})}
        </div>
        <div class="section-label">Chênh lệch SL vs KH — nhập tay (triệu kWh)</div>
        <div class="form-row">
          ${fi('Do sự cố (trong ngày)','chenh_su_co',{unit:'tr.kWh'})}
        </div>
        <div class="calc-hint" id="calcChenh">—</div>
        <div class="section-label">Chênh lệch lũy kế tháng (triệu kWh)</div>
        <div class="form-row">
          ${fi('Do sự cố','chenh_su_co_lk_t')}
          ${fi('Do thủy văn','chenh_tv_lk_t')}
          ${fi('Do EVN/A0','chenh_evn_lk_t')}
        </div>
        <div class="section-label">Chênh lệch lũy kế năm (triệu kWh)</div>
        <div class="form-row">
          ${fi('Do sự cố','chenh_su_co_lk_n')}
          ${fi('Do thủy văn','chenh_tv_lk_n')}
          ${fi('Do EVN/A0','chenh_evn_lk_n')}
        </div>
        <div class="section-label">Số giờ ngừng máy</div>
        <div class="form-row">
          ${fi('Toàn NM (ngày)','gio_ngung_nm',{unit:'h'})}
          ${fi('TM1 (ngày)','gio_ngung_tm1',{unit:'h'})}
          ${fi('TM2 (ngày)','gio_ngung_tm2',{unit:'h'})}
        </div>
        <div class="form-row">
          ${fi('Toàn NM (LK tháng)','gio_ngung_nm_lk_t',{unit:'h'})}
          ${fi('TM1 (LK tháng)','gio_ngung_tm1_lk_t',{unit:'h'})}
          ${fi('TM2 (LK tháng)','gio_ngung_tm2_lk_t',{unit:'h'})}
        </div>
        <div class="form-row">
          ${fi('Toàn NM (LK năm)','gio_ngung_nm_lk_n',{unit:'h'})}
          ${fi('TM1 (LK năm)','gio_ngung_tm1_lk_n',{unit:'h'})}
          ${fi('TM2 (LK năm)','gio_ngung_tm2_lk_n',{unit:'h'})}
        </div>
      </div>
    </div>`;
  updateSidebarKPI();
  updateWaterIndicator();
}

/* ── S3: Biểu đồ công suất ── */
function renderS3(c){
  const rows=PERIODS.map((t,i)=>{
    const isHour=i%2===0;
    const hrCls=isHour?' hr':'';
    const tot=fmt((P[i].tm1_p||0)+(P[i].tm2_p||0),1);
    return `<tr>
      <td class="ck${hrCls}">${t}</td>
      <td><input type="number" step="0.1" min="0" max="15" value="${P[i].tm1_p}" oninput="updP(${i},'tm1_p',this.value)"></td>
      <td><input type="number" step="0.1" min="0" max="15" value="${P[i].tm2_p}" oninput="updP(${i},'tm2_p',this.value)"></td>
      <td class="tot">${tot}</td>
    </tr>`;
  }).join('');
  c.innerHTML=`
    <div class="chart-box">
      <div class="chart-box-title">
        Đường cong công suất thực phát (MW) — 48 chu kỳ × 30 phút
        <div class="chart-legend">
          <span><i style="background:#1A5C38"></i>TM1</span>
          <span><i style="background:#0E4C8A"></i>TM2</span>
          <span><i style="background:#546E7A;opacity:.6"></i>Tổng</span>
        </div>
      </div>
      <div class="chart-canvas-wrap"><canvas id="powerChartCanvas"></canvas></div>
    </div>
    <div class="grid-wrap">
      <table>
        <thead><tr>
          <th style="width:72px">Chu kỳ</th>
          <th class="tm1c">TM1 · P (MW)</th>
          <th class="tm2c">TM2 · P (MW)</th>
          <th>Tổng (MW)</th>
        </tr></thead>
        <tbody>${rows}</tbody>
      </table>
    </div>`;
  updatePowerChart();
}

/* ── S4: Sự kiện & Ký tên ── */
function renderS4(c){
  c.innerHTML=`
    <div class="card">
      <div class="card-title"><span class="card-icon">📝</span>Nhật ký vận hành trong ngày</div>
      <div class="card-body">
        <div class="section-label">Tổ máy TM1</div>
        <div class="form-row">${fi('Sự kiện TM1','ev_tm1',{type:'textarea',rows:3})}</div>
        <div class="section-label">Tổ máy TM2</div>
        <div class="form-row">${fi('Sự kiện TM2','ev_tm2',{type:'textarea',rows:3})}</div>
        <div class="section-label">Đập & Công trình thủy công</div>
        <div class="form-row">${fi('Tình hình đập','ev_dap',{type:'textarea',rows:3})}</div>
        <div class="section-label">Trạm biến áp (TBA)</div>
        <div class="form-row">${fi('Tình hình TBA','ev_tba',{type:'textarea',rows:2})}</div>
        <div class="section-label">Ghi chú chung / Xác nhận bổ sung</div>
        <div class="form-row">${fi('Ghi chú','ev_note',{type:'textarea',rows:3})}</div>
      </div>
    </div>
    <div class="card">
      <div class="card-title"><span class="card-icon">✍️</span>Xác nhận & Ký tên</div>
      <div class="card-body">
        <div class="form-row">
          ${fi('Người lập báo cáo','signer',{type:'text'})}
          ${fi('Ngày ký','sign_date',{type:'text'})}
        </div>
      </div>
    </div>`;
  updateSidebarKPI();
}

// ═══════════════════════════════════════════════════════════
//  SIDEBAR
// ═══════════════════════════════════════════════════════════
function buildSidebar(){
  const nav=$('sidebarNav'); if(!nav) return;
  nav.innerHTML=SECTIONS.map((s,i)=>`
    <button class="nav-item ${i===currentSection?'active':''}" onclick="goSection(${i})">
      <span class="ni-icon">${s.icon}</span>
      <span class="ni-text">${s.title}<span class="ni-sub">${s.desc}</span></span>
    </button>`).join('');
}
function goSection(i){
  currentSection=i; buildSidebar();
  $('mainSectionName').textContent = SECTIONS[i].title;
  $('mainSectionDesc').textContent = SECTIONS[i].desc;
  const c=$('inputContainer');
  powerChartInst=null;
  [renderS0,renderS1,renderS2,renderS3,renderS4][i](c);
  updateSidebarKPI();
}

// ═══════════════════════════════════════════════════════════
//  REPORT CHART
// ═══════════════════════════════════════════════════════════
let rptChartInst=null;
function initRptChart(){
  const el=$('rptChartCanvas'); if(!el) return;
  if(rptChartInst){rptChartInst.destroy();rptChartInst=null;}
  const c=calc();
  rptChartInst=new Chart(el,{
    type:'line',
    data:{labels:HOURS,datasets:[
      {label:'TM1',data:c.hourlyP.map(h=>h.tm1),borderColor:'#1A5C38',backgroundColor:'rgba(26,92,56,.12)',fill:true,tension:.35,pointRadius:2,pointHoverRadius:4},
      {label:'TM2',data:c.hourlyP.map(h=>h.tm2),borderColor:'#0E4C8A',backgroundColor:'rgba(14,76,138,.08)',fill:true,tension:.35,pointRadius:2,pointHoverRadius:4},
      {label:'Tổng',data:c.hourlyP.map(h=>h.total),borderColor:'#37474F',borderWidth:2,borderDash:[5,3],fill:false,tension:.35,pointRadius:0},
    ]},
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{position:'top',labels:{boxWidth:16,font:{size:11}}}},
      scales:{
        x:{ticks:{font:{size:10}},grid:{color:'#F1F5F9'}},
        y:{beginAtZero:true,max:28,title:{display:true,text:'MW',font:{size:10}},
           ticks:{font:{size:10}},grid:{color:'#F1F5F9'}}
      }}
  });
}

// ═══════════════════════════════════════════════════════════
//  REPORT RENDER
// ═══════════════════════════════════════════════════════════
function renderReport(){
  const c=calc();
  const el=$('reportContent'); if(!el) return;
  if($('rptDateLabel')) $('rptDateLabel').textContent=D.date?`Ngày ${D.date}`:'';

  const f2=(v,d=2)=>v==null||isNaN(v)?'—':Number(v).toFixed(d);
  const td =(s,cls='')=>`<td class="${cls}">${s}</td>`;
  const tdn=(v,d=3)=>`<td class="r">${f2(v,d)}</td>`;

  // KPI helpers
  const pct_sl = n('kh_ngay')>0 ? c.sl_tm/n('kh_ngay')*100 : 0;
  const sl_cls = pct_sl>=100?'good':'warn';

  const mk=(label,val,unit,sub,pct,cls,showBar)=>`
    <div class="rpt-kcard ${cls}">
      <div class="rkc-lbl">${label}</div>
      <div class="rkc-val ${cls}">${val}</div>
      <div class="rkc-unit">${unit}</div>
      ${showBar&&pct>0?`
        <div class="rkc-prog-wrap"><div class="rkc-prog-bar" style="width:${Math.min(pct,100)}%;background:${cls==='good'?'#2E8B5A':cls==='warn'?'#EF5350':'#1976D2'}"></div></div>
        <div class="rkc-pct ${pct>=100?'good':'warn'}">${f2(pct,1)}%</div>`:''}
      <div class="rkc-sub">${sub}</div>
    </div>`;

  // Mực nước KPI
  const mn_diff=c.mn_diff;
  const mn_sign=mn_diff>=0?'↑+':'↓';
  const mn_cls=mn_diff<-0.3?'warn':mn_diff>0.3?'good':'water';

  // Lưu lượng KPI
  const q_cls=n('q_tran')>0?'warn':'water';

  // Hourly rows
  const hourlyRows=HOURS.map((h,i)=>{
    const hp=c.hourlyP[i];
    return `<tr>
      <td class="c">${h}</td>
      <td class="r" style="color:var(--tm1);font-weight:600">${f2(hp.tm1,2)}</td>
      <td class="r" style="color:var(--tm2);font-weight:600">${f2(hp.tm2,2)}</td>
      <td class="r b">${f2(hp.total,2)}</td>
    </tr>`;
  }).join('');

  // Chênh lệch tổng lũy kế
  const chenh_lk_t = n('chenh_su_co_lk_t')+n('chenh_tv_lk_t')+n('chenh_evn_lk_t');
  const chenh_lk_n = n('chenh_su_co_lk_n')+n('chenh_tv_lk_n')+n('chenh_evn_lk_n');

  el.innerHTML=`
    <div class="rpt-hdr">
      <div class="rpt-from">CÔNG TY CỔ PHẦN VRG - BẢO LỘC</div>
      <h2>Báo cáo tổng hợp tình hình vận hành trong ngày</h2>
      <h3>Nhà máy Thủy điện Bảo Lộc — Sông La Ngà · Lâm Đồng</h3>
      <div class="rpt-date">Từ 0g00 đến 24g00 ngày <b>${D.date}</b></div>
    </div>

    <div id="rpt-kpi" class="rpt-kpis">
      ${mk('SL thương mại thực tế',f2(c.sl_tm,4),'tr.kWh',`KH: ${f2(n('kh_ngay'),4)} tr.kWh`,pct_sl,sl_cls,true)}
      ${mk('Mực nước TL — 24h',f2(n('mn_tl_24'),2),'m',`${mn_sign}${f2(Math.abs(mn_diff),2)} m so với 0h`,0,mn_cls,false)}
      ${mk('Lưu lượng về hồ',f2(n('q_ve'),1),'m³/s',`Q phát: ${f2(c.q_phat_total,1)} m³/s · Q xả: ${f2(c.q_xa,1)} m³/s`,0,q_cls,false)}
      ${mk('Chênh lệch vs KH',f2(c.chenh_total,4),'tr.kWh',`SC·${f2(n('chenh_su_co'),3)}  TV·${f2(c.chenh_tv,3)}  A0·${f2(c.chenh_evn,3)}`,0,c.chenh_total>=0?'good':'warn',false)}
    </div>

    <div id="rpt-chart" class="rpt-chart-wrap">
      <div class="rpt-chart-hdr">📈 Đường cong công suất thực phát theo giờ (MW)</div>
      <div class="rpt-chart-body"><canvas id="rptChartCanvas"></canvas></div>
    </div>

    <div id="rpt-s1" class="sec">I. Công suất thực phát theo giờ (MW)</div>
    <div style="overflow-x:auto"><table>
      <thead>
        <tr>
          <th rowspan="2" style="width:68px;vertical-align:middle">Giờ</th>
          <th colspan="2">Công suất thực phát (MW)</th>
          <th rowspan="2" style="vertical-align:middle">Tổng giao nhận</th>
        </tr>
        <tr>
          <th style="background:var(--tm1-bg);color:var(--tm1)">TM1</th>
          <th style="background:var(--tm2-bg);color:var(--tm2)">TM2</th>
        </tr>
      </thead>
      <tbody>${hourlyRows}</tbody>
    </table></div>

    <div class="two-col">
      <div>
        <div id="rpt-s2" class="sec">II. Tình hình sản xuất điện</div>
        <table><thead><tr><th class="left">Chỉ tiêu</th><th>ĐV</th><th>Giá trị</th></tr></thead><tbody>
          <tr>${td('KH sản lượng ngày (VRG giao)')}${td('tr.kWh','c')}${tdn(n('kh_ngay'),4)}</tr>
          <tr>${td('SL đăng ký A0 (TM1+TM2)')}${td('tr.kWh','c')}${tdn(c.sl_dk,4)}</tr>
          <tr>${td('&nbsp;&nbsp;— TM1 đăng ký')}${td('MWh','c')}${tdn(n('sl_a0_tm1'),0)}</tr>
          <tr>${td('&nbsp;&nbsp;— TM2 đăng ký')}${td('MWh','c')}${tdn(n('sl_a0_tm2'),0)}</tr>
          <tr>${td('SL huy động A0 (TM1+TM2)')}${td('MWh','c')}${tdn(c.sl_hd*1000,0)}</tr>
          <tr>${td('<b>SL thương mại thực tế (TM1+TM2)</b>')}${td('tr.kWh','c')}<td class="r hl">${f2(c.sl_tm,4)}</td></tr>
          <tr>${td('SL đầu cực TM1+TM2')}${td('MWh','c')}${tdn(c.dc_total,1)}</tr>
          <tr>${td('SL tự dùng TM1+TM2')}${td('MWh','c')}${tdn(c.td_total,1)}</tr>
          <tr class="bg">${td('SL TM lũy kế tháng')}${td('MWh','c')}${tdn(n('sl_tm_lk_thang'),0)}</tr>
          <tr class="bg">${td('SL TM lũy kế năm')}${td('MWh','c')}${tdn(n('sl_tm_lk_nam'),0)}</tr>
          <tr class="bg">${td('SL TM lũy kế toàn bộ')}${td('MWh','c')}${tdn(n('sl_tm_lk_total'),0)}</tr>
        </tbody></table>
      </div>
      <div>
        <div id="rpt-s3" class="sec">III. Thủy văn & Hồ chứa</div>
        <table><tbody>
          <tr>${td('<b>MN thượng lưu — 0h00</b>')}${td('m','c')}<td class="r hl2">${f2(n('mn_tl_0'),2)}</td></tr>
          <tr>${td('<b>MN thượng lưu — 24h00</b>')}${td('m','c')}<td class="r hl2">${f2(n('mn_tl_24'),2)}</td></tr>
          <tr>${td('Biến động MN thượng lưu')}${td('m','c')}<td class="r ${mn_diff<0?'':'hl'}" style="${mn_diff<0?'color:#C62828;font-weight:700':''}">${(mn_diff>=0?'+':'')}${f2(mn_diff,2)}</td></tr>
          <tr>${td('MN hạ lưu')}${td('m','c')}${tdn(n('mn_hl'),2)}</tr>
          <tr>${td('<b>Q nước về hồ (bình quân ngày)</b>')}${td('m³/s','c')}<td class="r hlw">${f2(n('q_ve'),1)}</td></tr>
          <tr>${td('Q phát điện TM1')}${td('m³/s','c')}${tdn(n('q_phat_tm1'),1)}</tr>
          <tr>${td('Q phát điện TM2')}${td('m³/s','c')}${tdn(n('q_phat_tm2'),1)}</tr>
          <tr>${td('Q phát tổng (TM1+TM2)')}${td('m³/s','c')}${tdn(c.q_phat_total,1)}</tr>
          <tr>${td('Q xả tràn')}${td('m³/s','c')}${tdn(n('q_tran'),1)}</tr>
          <tr>${td('Q xả đáy')}${td('m³/s','c')}${tdn(n('q_day'),1)}</tr>
          <tr class="bg">${td('Nước về hồ — LK tháng')}${td('tr.m³','c')}${tdn(n('nuoc_lk_thang'),2)}</tr>
          <tr class="bg">${td('Nước về hồ — LK năm')}${td('tr.m³','c')}${tdn(n('nuoc_lk_nam'),2)}</tr>
        </tbody></table>
      </div>
    </div>

    <div id="rpt-s4" class="sec">IV. Chênh lệch KH vs Thực tế & Số giờ ngừng máy</div>
    <div class="two-col">
      <div>
        <table><thead><tr><th class="left">Nguyên nhân chênh lệch</th><th>Trong ngày</th><th>LK tháng</th><th>LK năm</th></tr></thead><tbody>
          <tr class="b">${td('Tổng (tr.kWh)')}${tdn(c.chenh_total,4)}${tdn(chenh_lk_t,4)}${tdn(chenh_lk_n,4)}</tr>
          <tr>${td('Do sự cố')}${tdn(n('chenh_su_co'),4)}${tdn(n('chenh_su_co_lk_t'),4)}${tdn(n('chenh_su_co_lk_n'),4)}</tr>
          <tr>${td('Do thủy văn / ấn định')}${tdn(c.chenh_tv,4)}${tdn(n('chenh_tv_lk_t'),4)}${tdn(n('chenh_tv_lk_n'),4)}</tr>
          <tr>${td('Do EVN / A0 điều độ')}${tdn(c.chenh_evn,4)}${tdn(n('chenh_evn_lk_t'),4)}${tdn(n('chenh_evn_lk_n'),4)}</tr>
        </tbody></table>
      </div>
      <div>
        <table><thead><tr><th class="left">Số giờ ngừng máy</th><th>Trong ngày</th><th>LK tháng</th><th>LK năm</th></tr></thead><tbody>
          <tr>${td('Toàn nhà máy')}${tdn(n('gio_ngung_nm'),0)}${tdn(n('gio_ngung_nm_lk_t'),0)}${tdn(n('gio_ngung_nm_lk_n'),0)}</tr>
          <tr>${td('TM1')}${tdn(n('gio_ngung_tm1'),0)}${tdn(n('gio_ngung_tm1_lk_t'),0)}${tdn(n('gio_ngung_tm1_lk_n'),0)}</tr>
          <tr>${td('TM2')}${tdn(n('gio_ngung_tm2'),0)}${tdn(n('gio_ngung_tm2_lk_t'),0)}${tdn(n('gio_ngung_tm2_lk_n'),0)}</tr>
        </tbody></table>
      </div>
    </div>

    <div id="rpt-s5" class="sec">V. Tình hình vận hành trong ngày</div>
    <table><thead><tr><th style="width:82px">Hạng mục</th><th class="left">Nội dung & sự kiện trong ngày</th></tr></thead><tbody>
      <tr>${td('TM1','c b')}${td(D.ev_tm1)}</tr>
      <tr>${td('TM2','c b')}${td(D.ev_tm2)}</tr>
      <tr>${td('Đập','c b')}${td(D.ev_dap)}</tr>
      <tr>${td('TBA','c b')}${td(D.ev_tba)}</tr>
    </tbody></table>
    <div class="ev-note">${D.ev_note}</div>
    <div class="sign">
      <div class="sign-box">
        <div class="sign-role">Người lập báo cáo</div>
        <div class="sign-space"></div>
        <div class="sign-name">${D.signer}</div>
        <div class="sign-date">Ngày ${D.sign_date}</div>
      </div>
    </div>`;
}

// ═══════════════════════════════════════════════════════════
//  TAB SWITCH & SCROLL
// ═══════════════════════════════════════════════════════════
function switchTab(tab){
  const isInput=tab==='input';
  $('inputPanel').classList.toggle('hidden',!isInput);
  $('reportPanel').classList.toggle('hidden',isInput);
  $('modeInput').classList.toggle('active',isInput);
  $('modeReport').classList.toggle('active',!isInput);
  if(!isInput){ renderReport(); setTimeout(initRptChart,0); }
}
function scrollToId(id){
  const el=$(id);
  if(el){ const mc=document.querySelector('#reportPanel .main-content'); if(mc) mc.scrollTop=el.offsetTop-20; }
}

// ═══════════════════════════════════════════════════════════
//  INIT
// ═══════════════════════════════════════════════════════════
buildSidebar();
goSection(0);
</script>
</body>
</html>
